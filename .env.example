# Environment Configuration for PromoRadar
NODE_ENV="development"
PORT=3000

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database (Prisma)
# Example: postgresql://postgres:postgres@localhost:5432/promoradar?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/promoradar?schema=public"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-key-change-this-in-production-min-32-chars"

# Redis (BullMQ Worker & Cache)
REDIS_URL="redis://localhost:6379"

# Object Storage (S3 / Cloudflare R2) - Optional for Phase 1
S3_ENDPOINT=""
S3_BUCKET_NAME=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

